# Copy to .env and adjust. Never commit your real .env.

# Secret used to sign access-token JWTs. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=jwt-auth-service

# Access-token lifetime in seconds (kept short; default 15 minutes).
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh-token lifetime in seconds (default 7 days).
REFRESH_TOKEN_TTL_SECONDS=604800
